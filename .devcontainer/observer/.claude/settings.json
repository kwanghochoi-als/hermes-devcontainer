{
  "permissions": {
    "defaultMode": "dontAsk",
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Agent",
      "Task",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I -B /opt/hermes-observer/.observer/gate.py",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I -B /opt/hermes-observer/.observer/gate.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
